<%
  const groups = [
    { items: [['/', 'Dashboard']] },
    { title: 'Keuangan', items: [['/pemasukan', 'Pemasukan'], ['/pengeluaran', 'Pengeluaran'], ['/transfer', 'Transfer'], ['/akun', 'Akun']] },
    { title: 'Usaha', items: [['/usaha', 'Daftar usaha'], ['/produk', 'Produk'], ['/penjualan', 'Penjualan']] },
    { title: 'Persediaan', items: [['/stok', 'Stok']] },
    { title: 'Laporan', items: [['/laporan/laba-rugi', 'Laba rugi'], ['/laporan/cash-flow', 'Cash flow'], ['/analitik', 'Analitik']] },
    { title: 'Pengelolaan', items: [['/kategori', 'Kategori']].concat(isAdmin ? [['/pengguna', 'Pengguna']] : []).concat([['/pengaturan', 'Pengaturan']]) },
  ];
  const active = (href) => href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
%>
<aside id="sidebar" class="hidden lg:flex lg:flex-col lg:w-60 lg:shrink-0 lg:sticky lg:top-0 lg:h-screen bg-ink text-white/90 px-3 py-5 overflow-y-auto">
  <div class="px-2 mb-6">
    <div class="font-display text-xl font-bold text-white">Keuangan Finance</div>
    <div class="text-xs text-white/60">Keuangan dan usaha</div>
  </div>
  <nav class="flex-1 space-y-4" aria-label="Menu utama">
    <% groups.forEach(g => { %>
      <div>
        <% if (g.title) { %><div class="px-2 mb-1 text-xs text-white/50"><%= g.title %></div><% } %>
        <% g.items.forEach(([href, label]) => { %>
          <a href="<%= href %>" <%- active(href) ? 'aria-current="page"' : '' %>
             class="block rounded-md px-2.5 py-1.5 text-sm <%= active(href) ? 'bg-white/12 text-mint font-semibold' : 'hover:bg-white/8' %>"><%= label %></a>
        <% }) %>
      </div>
    <% }) %>
  </nav>
  <form method="post" action="/logout" class="mt-4 border-t border-white/15 pt-4 px-2">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="text-sm font-medium text-white truncate"><%= user.name %></div>
    <div class="text-xs text-white/60 mb-2"><%= user.role === 'admin' ? 'Admin' : user.role === 'bendahara' ? 'Bendahara' : 'Anggota Keuangan' %></div>
    <button class="text-sm text-mint hover:underline">Keluar</button>
  </form>
</aside>
