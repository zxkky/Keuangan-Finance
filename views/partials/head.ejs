<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Keuangan Finance</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: { extend: {
      colors: { paper: '#F1F4F6', ink: '#13243B', line: '#D8E0E7', muted: '#5F6F82', primary: '#0B7A68', 'primary-dark': '#075E50', loss: '#B3374A', warn: '#B7791F', mint: '#8FE3CB' },
      fontFamily: { body: ['Figtree', 'system-ui', 'sans-serif'], display: ['"Bricolage Grotesque"', 'Figtree', 'sans-serif'] }
    } }
  };
</script>
<style type="text/tailwindcss">
  @layer components {
    .card { @apply bg-white border border-line rounded-md; }
    .field { @apply w-full rounded-md border border-line bg-white px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary; }
    .lbl { @apply block text-sm font-medium text-ink/80 mb-1; }
    .btn { @apply inline-flex items-center justify-center gap-1.5 rounded-md px-3.5 py-2 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 disabled:opacity-50; }
    .btn-primary { @apply bg-primary text-white hover:bg-primary-dark; }
    .btn-ghost { @apply border border-line bg-white text-ink hover:bg-paper; }
    .btn-link { @apply text-sm font-medium text-primary hover:underline; }
    .btn-danger { @apply text-sm font-medium text-loss hover:underline; }
    .th { @apply px-3 py-2 text-left text-xs font-semibold text-muted whitespace-nowrap; }
    .td { @apply px-3 py-2.5 text-sm align-top; }
    .num { @apply text-right tabular-nums whitespace-nowrap; }
    .page-title { @apply font-display text-2xl font-bold tracking-tight; }
    .dlg { @apply rounded-md border border-line p-0 w-[min(32rem,calc(100vw-2rem))] backdrop:bg-ink/40; }
  }
</style>
