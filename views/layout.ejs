<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
</head>
<body class="bg-paper text-ink font-body antialiased">
  <a href="#isi" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-2">Lewati ke isi</a>
  <div class="lg:flex min-h-screen">
    <%- include('partials/sidebar') %>
    <main class="flex-1 min-w-0">
      <div class="lg:hidden flex items-center justify-between bg-ink text-white px-4 py-3">
        <span class="font-display font-bold">Keuangan Finance</span>
        <button type="button" id="menu-toggle" class="rounded-md border border-white/30 px-3 py-1 text-sm" aria-controls="sidebar" aria-expanded="false">Menu</button>
      </div>
      <div id="isi" class="px-4 sm:px-8 py-6 max-w-6xl">
        <% if (flash) { %>
          <div role="status" class="mb-5 rounded-md border px-4 py-3 text-sm <%= flash.type === 'error' ? 'border-loss/40 bg-loss/10 text-loss' : 'border-primary/40 bg-primary/10 text-primary-dark' %>"><%= flash.msg %></div>
        <% } %>
        <%- body %>
      </div>
    </main>
  </div>
  <script src="/js/app.js"></script>
  <%- script %>
</body>
</html>
